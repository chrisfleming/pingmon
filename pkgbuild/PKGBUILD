pkgname=pingmon
pkgver=0.1.0
pkgrel=1
pkgdesc='Desktop window for the ping-monitor server: starts it and shows live latency per host'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'python' 'iputils')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/pingmon "$pkgdir/usr/bin/pingmon"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 server/ping_server.py "$pkgdir/usr/share/pingmon/server/ping_server.py"
  install -Dm644 server/monitor_common.py "$pkgdir/usr/share/pingmon/server/monitor_common.py"
  install -Dm644 "$startdir/pingmon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/pingmon.svg"
  install -Dm644 "$startdir/pingmon.desktop" "$pkgdir/usr/share/applications/pingmon.desktop"
}
